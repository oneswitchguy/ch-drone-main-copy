// NOTE: BUNDLE_NAME is overridden per-target in project.pbxproj as "HO Flight".
// That short form is what appears under the app icon; CFBundleName should stay
// under ~15 characters. BUNDLE_DISPLAY_NAME below is the full user-facing name.
BUNDLE_NAME = HandsOptional Flight Lab
PRODUCT_NAME = $(TARGET_NAME)
BUNDLE_DISPLAY_NAME = HandsOptional Flight Lab
INFOPLIST_FILE = CH Drone 2/Info.plist

CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_STYLE = Automatic
//CODE_SIGN_ENTITLEMENTS = $(PROJECT_NAME)/$(PROJECT_NAME).entitlements
DEVELOPMENT_TEAM = RKHD32Y276   // Astrocode Pty Ltd

SWIFT_OBJC_BRIDGING_HEADER = CH Drone 2/CH Drone-Bridging-Header.h

// Versioning
MARKETING_VERSION = 1.0.0

// Asset Catalog Compiler - Options
ASSETCATALOG_COMPILER_APPICON_NAME = hologo
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

PRODUCT_BUNDLE_IDENTIFIER = com.christopherhills.chdrone2
DJI_SDK_APP_KEY = 5237986abd3a6c10f5afd646

TARGETED_DEVICE_FAMILY = 2 // iPad
ENABLE_BITCODE = NO
