ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
EXCLUDED_ARCHS[sdk=iphoneos*] = x86_64 armv7 i386
EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64 armv7 i386
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta" "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Accessory" "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Core" "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Flight" "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Map" "${PODS_CONFIGURATION_BUILD_DIR}/DJIWidget" "${PODS_ROOT}/DJI-SDK-iOS/iOS_Mobile_SDK" "${PODS_ROOT}/DJIWidget/FFmpeg"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Accessory/UXSDKAccessory.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Core/UXSDKCore.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Flight/UXSDKFlight.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Map/UXSDKMap.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta/DJIUXSDKBeta.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/DJIWidget/DJIWidget.framework/Headers" "$(PODS_ROOT)/DJIWidget/FFmpeg/FFmpeg.framework/Headers" "$(PODS_ROOT)/Headers/Public/DJIWidget/FFmpeg/.."/**
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift "$(PLATFORM_DIR)/Developer/Library/Frameworks" '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_CFLAGS = $(inherited) -isystem "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta/DJIUXSDKBeta.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Accessory/UXSDKAccessory.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Core/UXSDKCore.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Flight/UXSDKFlight.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Map/UXSDKMap.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/DJIWidget/DJIWidget.framework/Headers" -iframework "${PODS_ROOT}/DJI-SDK-iOS/iOS_Mobile_SDK" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Accessory" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Core" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Flight" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Map" -iframework "${PODS_ROOT}/DJIWidget/FFmpeg" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/DJIWidget"
OTHER_LDFLAGS = $(inherited) -ObjC -all_load -framework "DJISDK" -framework "DJIUXSDKBeta" -framework "DJIWidget" -framework "FFmpeg" -framework "UXSDKAccessory" -framework "UXSDKCore" -framework "UXSDKFlight" -framework "UXSDKMap"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/DJI-SDK-iOS" "-F${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta" "-F${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Accessory" "-F${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Core" "-F${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Flight" "-F${PODS_CONFIGURATION_BUILD_DIR}/DJI-UXSDK-iOS-Beta-Map" "-F${PODS_CONFIGURATION_BUILD_DIR}/DJIFlySafeDatabaseResource" "-F${PODS_CONFIGURATION_BUILD_DIR}/DJIWidget"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
